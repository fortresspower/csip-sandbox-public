{
  "name": "fortress-csip-sandbox",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:client-core-scale": "node --expose-gc --import tsx scripts/client-core-scale.ts",
    "demo": "bash scripts/demo-loop.sh",
    "cert:lfdi": "tsx scripts/certificate-lfdi.ts",
    "server:admin": "tsx scripts/server-admin.ts",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:verify": "node scripts/release-bundle.mjs --verify"
  },
  "dependencies": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "$qs"
  }
}
